# Port the control panel listens on
PORT=4000

# Public URL of this control panel (used to build absolute file URLs in the public API)
# e.g. https://admin.example.com
PUBLIC_BASE_URL=http://localhost:4000

# Comma-separated list of website origins allowed to call the public API from the browser.
# Use * to allow any origin.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:5500

# First admin account (created automatically on first start if no admin exists).
# If ADMIN_PASSWORD is empty a random one is generated and printed to the console.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Number of reverse proxies in front of this app (e.g. 1 behind nginx). 0 = none.
TRUST_PROXY=0

# Where the database and uploaded files are stored. Defaults: ./data and ./uploads locally,
# /home/data/seedwebadmin on Azure App Service (persistent storage).
# DATA_DIR=
# UPLOAD_DIR=

# Set to true when served over HTTPS so session cookies are marked Secure
COOKIE_SECURE=false

# Upload size limits in megabytes
MAX_IMAGE_MB=10
MAX_VIDEO_MB=300
MAX_FILE_MB=20
